<Window x:Class="BetterGenshinImpact.View.CaptureCurrentImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="当前窗口图像"
        Width="900"
        Height="700"
        FontFamily="{DynamicResource TextThemeFontFamily}"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AnalyzeModeButton"
                        Content="颜色分析模式"
                        Margin="4,0"
                        Padding="12,6"
                        Click="AnalyzeModeButton_Click"/>
                <Button x:Name="ExitAnalyzeButton"
                        Content="退出分析"
                        Margin="4,0"
                        Padding="12,6"
                        Visibility="Collapsed"
                        Click="ExitAnalyzeButton_Click"/>
                <Rectangle Width="1" Fill="#555555" Margin="8,0"/>
                <Button x:Name="SelectModeButton"
                        Content="框选模式"
                        Margin="4,0"
                        Padding="12,6"
                        Click="SelectModeButton_Click"/>
                <Button x:Name="CropButton"
                        Content="裁剪保存"
                        Margin="4,0"
                        Padding="12,6"
                        Click="CropButton_Click"
                        IsEnabled="False"/>
                <Button x:Name="SaveOriginalButton"
                        Content="保存原图"
                        Margin="4,0"
                        Padding="12,6"
                        Click="SaveOriginalButton_Click"/>
                <Button x:Name="SaveMarkedButton"
                        Content="保存带框截图"
                        Margin="4,0"
                        Padding="12,6"
                        Click="SaveMarkedButton_Click"
                        IsEnabled="False"/>
                <TextBlock VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           Foreground="#999999"
                           FontSize="12">
                    <Run Text="提示：滚轮缩放，Ctrl+滚轮精确缩放"/>
                </TextBlock>
                <TextBlock x:Name="ImageSizeText"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           Foreground="#999999"
                           FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- 图像显示区域 -->
        <Border Grid.Row="1"
                x:Name="ImageBorder"
                Background="#1A1A1A"
                ClipToBounds="True"
                MouseWheel="ImageBorder_MouseWheel"
                MouseLeftButtonDown="ImageBorder_MouseLeftButtonDown"
                MouseLeftButtonUp="ImageBorder_MouseLeftButtonUp"
                MouseMove="ImageBorder_MouseMove">
            <Canvas x:Name="ImageCanvas"
                    Background="Transparent">
                <Image x:Name="DisplayImage"
                       Stretch="None"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       IsHitTestVisible="False"/>
                <!-- 框选矩形 -->
                <Canvas x:Name="SelectionCanvas"
                        Background="Transparent"
                        Visibility="Collapsed"/>
            </Canvas>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#2D2D2D" Padding="8,4">
            <TextBlock x:Name="StatusText"
                       Text="拖动图像平移，滚轮缩放"
                       Foreground="#999999"
                       FontSize="12"/>
        </Border>
    </Grid>
</Window>